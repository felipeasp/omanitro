<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>OmaNitro</vendor>
  <vendor_url>https://github.com/felipeasp/omanitro</vendor_url>

  <action id="io.github.felipeasp.omanitro.control">
    <description>Control Acer Nitro hardware settings</description>
    <description xml:lang="pt_BR">Controlar configurações de hardware do Acer Nitro</description>
    <message>Authentication is required to modify Acer Nitro cooling, power, and graphics settings.</message>
    <message xml:lang="pt_BR">Autenticação necessária para modificar refrigeração, energia e gráficos do Acer Nitro.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/omanitro/nitro-helper.sh</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
